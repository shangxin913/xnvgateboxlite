[Unit]
Description=GateBox Lite management API
After=network.target

[Service]
Type=simple
User=gateboxlite
Group=gateboxlite
WorkingDirectory=/opt/gateboxlite
EnvironmentFile=/etc/gateboxlite/environment
ExecStart=/opt/gateboxlite/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8899 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gateboxlite
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
